# Never commit a real token. Prefer `node bin/hds-baidu.mjs token login`.
BAIDU_NETDISK_ACCESS_TOKEN=
# App credentials, only needed by `token login` and `token refresh`.
BAIDU_APP_KEY=
BAIDU_SECRET_KEY=
